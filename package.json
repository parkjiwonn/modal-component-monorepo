{
  "name": "my-app-v2-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=@my-app/web",
    "build": "npm run build --workspace=@my-app/web",
    "test": "npm run test --workspace=@my-app/web",
    "build:modal": "npm run build --workspace=@my-app/modal",
    "dev:modal": "npm run dev --workspace=@my-app/modal",
    "install:all": "npm install"
  },
  "devDependencies": {
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "typescript": "^4.9.5"
  }
}